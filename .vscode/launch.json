    "version": "0.2.0",
    "configurations": [


        {
            "name": "kitahack2026",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "kitahack2026 (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "kitahack2026 (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "Flutter Web (No CORS)",
            "request": "launch",
            "type": "dart",
            "args": [
                "--web-browser-flag",
                "--disable-web-security" 
            ]
        }
    ]
}